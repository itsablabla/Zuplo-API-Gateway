{
  "openapi": "3.1.0",
  "info": {
    "title": "Superjoy API Gateway",
    "version": "1.0.0",
    "description": "Fronts the Joy gateway (OpenAI Responses API backed by DeepSeek)."
  },
  "paths": {
    "/v1/responses": {
      "post": {
        "operationId": "joyResponses",
        "summary": "Joy responses (proxied)",
        "responses": {
          "200": {
            "description": "Streamed Responses API events"
          },
          "429": {
            "description": "Per-customer model rate limit exceeded"
          }
        },
        "x-zuplo-route": {
          "handler": {
            "export": "urlRewriteHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "rewritePattern": "https://superjoy-model-gateway.fly.dev/v1/responses",
              "forwardSearch": true
            }
          },
          "policies": {
            "inbound": [
              "api-key-inbound",
              "customer-model-rate-limit",
              "forward-consumer"
            ]
          },
          "label": "Joy responses"
        },
        "description": "Authenticate a customer machine and proxy one OpenAI-compatible Joy response through the protected model gateway.",
        "tags": [
          "Joy"
        ]
      }
    },
    "/v1/models": {
      "get": {
        "operationId": "joyModels",
        "summary": "List models (proxied)",
        "responses": {
          "200": {
            "description": "Model list"
          }
        },
        "x-zuplo-route": {
          "handler": {
            "export": "urlRewriteHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "rewritePattern": "https://superjoy-model-gateway.fly.dev/v1/models"
            }
          },
          "policies": {
            "inbound": [
              "api-key-inbound",
              "forward-consumer"
            ]
          },
          "label": "Joy models"
        },
        "description": "Return the model identifiers available to an authenticated customer machine.",
        "tags": [
          "Joy"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Health (proxied)",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "x-zuplo-route": {
          "handler": {
            "export": "urlRewriteHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "rewritePattern": "https://superjoy-model-gateway.fly.dev/health"
            }
          },
          "policies": {
            "inbound": [
              "api-key-inbound"
            ]
          },
          "label": "Joy gateway health"
        },
        "description": "Check that Zuplo can reach the Joy model gateway.",
        "tags": [
          "Operations"
        ]
      }
    }
  }
}
