{
  "openapi": "3.1.0",
  "info": {
    "title": "Superjoy API Gateway",
    "version": "1.0.0",
    "description": "Fronts the Joy gateway (OpenAI Responses API backed by DeepSeek)."
  },
  "paths": {
    "/v1/responses": {
      "post": {
        "operationId": "joyResponses",
        "summary": "Joy responses (proxied)",
        "responses": {
          "200": {
            "description": "Streamed Responses API events"
          }
        },
        "x-zuplo-route": {
          "handler": {
            "export": "urlRewriteHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "rewritePattern": "https://superjoy-joy-gateway.fly.dev/v1/responses",
              "forwardSearch": true
            }
          },
          "policies": {
            "inbound": [
              "api-key-inbound"
            ]
          }
        }
      }
    },
    "/v1/models": {
      "get": {
        "operationId": "joyModels",
        "summary": "List models (proxied)",
        "responses": {
          "200": {
            "description": "Model list"
          }
        },
        "x-zuplo-route": {
          "handler": {
            "export": "urlRewriteHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "rewritePattern": "https://superjoy-joy-gateway.fly.dev/v1/models"
            }
          },
          "policies": {
            "inbound": [
              "api-key-inbound"
            ]
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Health (proxied)",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "x-zuplo-route": {
          "handler": {
            "export": "urlRewriteHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "rewritePattern": "https://superjoy-joy-gateway.fly.dev/health"
            }
          },
          "policies": {
            "inbound": [
              "api-key-inbound"
            ]
          }
        }
      }
    }
  }
}